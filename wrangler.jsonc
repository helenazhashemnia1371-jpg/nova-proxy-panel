{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova-proxy-panel",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f3f85ecc-3bfd-49b0-8fbd-ccfda62f8a18","database_name": "nova-proxy-panelkv" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "3aff5a9d7289443096ab8eb9e8421c28" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
